# Copy file này thành .env để đổi cấu hình docker compose (file .env KHÔNG commit).
# Nếu đổi mật khẩu SA, cập nhật luôn ConnectionStrings:Upm (appsettings.Development.json
# hoặc `dotnet user-secrets set "ConnectionStrings:Upm" "..." --project src/Upm.Api`).

# SQL Server 2022 – mật khẩu phải đủ mạnh (≥ 8 ký tự, có hoa, thường, số, ký tự đặc biệt)
MSSQL_SA_PASSWORD=Upm@Dev12345
MSSQL_PORT=1433

# Mailpit – SMTP nhận mọi email gửi đi ở môi trường dev, xem tại http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
