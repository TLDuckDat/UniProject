# Cấu hình môi trường cho UniProject.API - Copy file này thành .env rồi điền giá trị thật.
# Quy ước: "__" (hai dấu gạch dưới) thay cho ":" của appsettings. Ví dụ Jwt__Key  <=>  Jwt:Key

# --- Database ---
ConnectionStrings__DefaultConnection=Server=.;Database=QLDoAnCoSoChuyenNganh;Trusted_Connection=True;TrustServerCertificate=True

# --- JWT ---
Jwt__Issuer=QLDoAn
Jwt__Audience=QLDoAn
# Khóa ký token, tối thiểu 32 ký tự
Jwt__Key=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu
Jwt__ExpiryMinutes=120
Jwt__RefreshTokenExpiryDays=7

# true = tạo tài khoản demo + dữ liệu mẫu khi khởi động (chỉ dùng khi phát triển).
# Dữ liệu đọc từ Data/Seed/ (thật, không commit), thiếu thì dùng Data/Seed.example/ (hư cấu).
SeedSampleData=true

# --- Tham số loại đồ án (tùy chọn; mặc định nằm trong appsettings.json) ---
# Khóa: ProjectTypes__<DO_AN_CO_SO|DO_AN_CHUYEN_NGANH|DO_AN_MON_HOC|DO_AN_TOT_NGHIEP>__<Tham số>. Sai cấu hình thì ứng dụng dừng khi khởi động.
# MaxMembers (1-10), HasReviewer (true/false), AdvisorWeightPercent + ReviewerWeightPercent + CommitteeWeightPercent = 100,
# PassingScore (mặc định 5), MinComponentScore (mặc định 4; 0 = tắt), GradingMode (CHAM_RIENG | CHAM_CHUNG)
# Ví dụ: ProjectTypes__DO_AN_CO_SO__MaxMembers=3

# --- CORS (tùy chọn) ---
# Mặc định cho phép frontend ở http://localhost:5500 và http://127.0.0.1:5500 (VS Code Live Server)
# Cors__AllowedOrigins__0=http://localhost:5500
# Cors__AllowedOrigins__1=http://localhost:3000
